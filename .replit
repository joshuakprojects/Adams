# Replit settings for the dispatch app.
# Secrets (TWILIO_*, ADMIN_PASSWORD…) go in the Replit "Secrets" tool, not in this file.
modules = ["nodejs-22"]
run = "npm install && npm start"
# Every time the project starts, bring the editor's database up to date (new tables / columns), so Publish never
# offers to delete tables from the live database. See README "Updating on Replit".
onBoot = "npm install --silent --no-audit --no-fund && npm run db:sync"

[[ports]]
localPort = 3000
externalPort = 80

[deployment]
# A Reserved VM keeps running all day, so the 5 PM "tomorrow's jobs" text still goes out.
deploymentTarget = "gce"
build = ["npm", "ci", "--omit=dev"]
run = ["npm", "start"]
