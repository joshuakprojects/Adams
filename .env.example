# Copy to .env and fill in.
PORT=3000
# The public address of this app — used for the links in texts and to check Twilio's signature.
PUBLIC_URL=https://dispatch.adamsbros.ca
COOKIE_SECURE=true

# First office login (created on first start if there are no users).
ADMIN_EMAIL=office@adamsbros.ca
ADMIN_PASSWORD=change-me-please

COMPANY_NAME=ADAMS BROS
# Shown as a "Call dispatch" button on the driver's job page.
DISPATCH_PHONE=+14035550000
# Time zone used for "today" and the evening lineup text (Eastern).
TZ_NAME=America/Toronto
# First-start default for texting drivers tomorrow's jobs (HH:MM, blank = off). Change it later on the Setup tab.
LINEUP_TIME=17:00
# Where scale ticket photos are saved (back this up along with the database).
# UPLOAD_DIR=./data/uploads

# Twilio — leave blank to run in test mode (texts are printed in the log instead of sent).
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
