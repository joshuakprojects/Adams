# Copy to .env and fill in.
PORT=3000
# The public address of this app — used for the links in texts and to check Twilio's signature.
PUBLIC_URL=https://dispatch.adamsbros.ca
COOKIE_SECURE=true

# First office login (created on first start if there are no users).
ADMIN_EMAIL=office@adamsbros.ca
ADMIN_PASSWORD=change-me-please

COMPANY_NAME=ADAMS BROS
# Printed on work orders (these are the defaults).
# COMPANY_LEGAL_NAME=Adams Bros. Construction Ltd.
# COMPANY_ADDRESS=116 William St., P.O. Box 324, Parry Sound, ON  P2A 2X4
# COMPANY_PHONE=(705) 746-2962
# COMPANY_EMAIL=info@adamsbros.ca
# COMPANY_HST=R100046929
# Shown as a "Call dispatch" button on the driver's job page.
DISPATCH_PHONE=+17057462962
# Time zone used for "today" and the evening lineup text (Eastern).
TZ_NAME=America/Toronto
# First-start default for texting drivers tomorrow's jobs (HH:MM, blank = off). Change it later on the Setup tab.
LINEUP_TIME=17:00
# Where scale ticket photos are saved (back this up along with the database).
# UPLOAD_DIR=./data/uploads

# Twilio — leave blank to run in test mode (texts are printed in the log instead of sent).
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Website orders: the website sends each order to /api/intake with this key (Authorization: Bearer ...).
# Use a long random string (letters and numbers), and put the same value in the website's DISPATCH_INTAKE_KEY.
INTAKE_KEY=

# Map view: a Google Maps browser key (Maps JavaScript API + Geocoding API), restricted to your dispatch web address.
GOOGLE_MAPS_API_KEY=
# Optional: your own Google map style ID (otherwise Google's default style).
# GOOGLE_MAPS_MAP_ID=
# Yard shown on the map.
# YARD_ADDRESS=116 William St, Parry Sound, ON P2A 1V4

# Nightly backups: replit (Replit Object Storage, the default on Replit), local (BACKUP_DIR, default data/backups), or off.
# BACKUP_TARGET=
# BACKUP_DIR=./data/backups
