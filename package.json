{
  "name": "adams-dispatch",
  "version": "0.1.0",
  "private": true,
  "description": "Truck dispatch for Adams Bros: office dashboard + SMS to drivers",
  "main": "src/server.js",
  "engines": { "node": ">=22.5" },
  "scripts": {
    "start": "node --experimental-sqlite --disable-warning=ExperimentalWarning src/server.js",
    "dev": "node --experimental-sqlite --disable-warning=ExperimentalWarning --watch src/server.js",
    "seed": "node --experimental-sqlite --disable-warning=ExperimentalWarning scripts/seed.js",
    "add-user": "node --experimental-sqlite --disable-warning=ExperimentalWarning scripts/add-user.js",
    "twilio": "node --experimental-sqlite --disable-warning=ExperimentalWarning scripts/twilio.js",
    "test": "node --experimental-sqlite --disable-warning=ExperimentalWarning --test \"test/*.test.js\""
  },
  "dependencies": {
    "express": "4.21.2"
  }
}
